# HTTP listen address (default :9000)
ADDR=:9000

# Grok Turnstile helper（仅 Linux 完整注册环境使用；Windows 仅运行管理台/API，必须留空）
# GROK_TURNSTILE_PYTHON=/opt/cloakbrowser-venv/bin/python
# GROK_TURNSTILE_SCRIPT=/usr/local/share/grok-reg/turnstile_mint.py
# 可选：外部并发调度脚本路径（Go 服务不会自动读取）
# GROK_TURNSTILE_POOL_SCRIPT=/usr/local/share/grok-reg/turnstile_pool.py
# TURNSTILE_MODE=offscreen

# 可选：启用 FlareSolverr clearance 兜底时，指向用户自行准备的 docker-compose 目录
# GROK_CLEARANCE_DIR=/opt/Grok-Register/clearance

# Keep credentials and proxy URLs out of source control; configure them in the UI/database.
